{
  "name": "urc",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@pusher/push-notifications-server": "^1.2.7",
    "@pusher/push-notifications-web": "^1.1.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@upstash/redis": "^1.35.5",
    "@vercel/postgres": "^0.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "dev": "node --env-file=.env.development.local scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node --env-file=.env.development.local node_modules/@playwright/test/cli.js test",
    "web": "vite",
    "format": "prettier --write \"{src,api,lib,scripts,tests}/**/*.{js,jsx,ts,tsx,mjs,css}\" \"*.{json,ts,html}\" \"public/*.{js,json}\" \".prettierrc.json\"",
    "format:check": "prettier --check \"{src,api,lib,scripts,tests}/**/*.{js,jsx,ts,tsx,mjs,css}\" \"*.{json,ts,html}\" \"public/*.{js,json}\" \".prettierrc.json\"",
    "lint": "eslint src api lib scripts tests *.ts eslint.config.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.36.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^14.0.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
